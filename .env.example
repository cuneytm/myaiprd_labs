# Bu dosyayı .env adıyla kopyalayın ve kendi bilgilerinizi yazın.

# ---------------------------------------------------------------- MODEL
# Model, OpenAI uyumlu bir /v1 API'si sunmalı ve tool calling desteklemelidir.
#   Ollama (yerel):    http://localhost:11434/v1
#   LM Studio (yerel): http://localhost:1234/v1
#   vLLM / gateway:    http://SUNUCU:8000/v1
#   OpenAI:            https://api.openai.com/v1
MODEL_BASE_URL=http://localhost:11434/v1

# Model adı (sunucuda göründüğü haliyle). Örnek: qwen3:8b, llama3.1:8b, gpt-4.1-mini
MODEL_NAME=qwen3:8b

# API anahtarı. Ollama ve LM Studio anahtar istemez; o durumda "yok" yazın.
MODEL_API_KEY=yok

# ---------------------------------------------------------------- KLASÖR
# Agent'ın üzerinde çalışacağı klasörün TAM yolu.
#   macOS örneği:   /Users/kullaniciadi/Documents/lab-klasoru
#   Windows örneği: C:\Users\kullaniciadi\Documents\lab-klasoru
# Göreli bir yol (ör. ornek-klasor) depo köküne göre çözülür.
# Boş bırakılırsa depodaki ornek-klasor kullanılır.
# İpucu: önemli dosyaların olduğu bir klasör yerine bir kopya ya da test klasörü verin;
# agent bu klasörde dosya oluşturabilir ve dosyaların üzerine yazabilir.
WORK_DIR=

# ---------------------------------------------------------------- AGENT
# Bir görevde agent'ın en fazla kaç model çağrısı yapabileceği
MAX_STEPS=10
